# ─── LifeLine Streamlit Secrets Template ────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to source control.
# ────────────────────────────────────────────────────────────────────────────

# Backend base URL (no trailing slash, no /api suffix)
# Example for local dev:
#   BACKEND_URL = "http://localhost:5000"
# Example for Render:
#   BACKEND_URL = "https://your-app.onrender.com"
BACKEND_URL = "https://your-backend-on-render.onrender.com"
