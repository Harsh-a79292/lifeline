# ─── LifeLine Backend Environment Template ───────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (Render sets this automatically)
PORT=5000

# Node environment
NODE_ENV=development

# MongoDB Atlas connection string
# Replace <username>, <password>, <cluster-host> with your Atlas credentials
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/lifeline?retryWrites=true&w=majority

# JWT signing secret — use a long, random string in production
JWT_SECRET=your_very_long_random_secret_here_change_before_deploy

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Dev example:   http://localhost:8501,http://127.0.0.1:8501
# Prod example:  https://your-app.streamlit.app
CLIENT_ORIGIN=http://localhost:8501,http://127.0.0.1:8501
